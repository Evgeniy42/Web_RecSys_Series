# ─── Переменные окружения для production ─────────────────────────────────

# PostgreSQL
POSTGRES_USER=recsys_user
POSTGRES_PASSWORD=your-strong-password-here
POSTGRES_DB=recsys_series

# Секретный ключ для сессий
SECRET_KEY=your-random-secret-key-here

# API-ключ TMDB (https://www.themoviedb.org/settings/api) — нужен только
# для standalone-скрипта импорта фильмов из датасета MovieLens
TMDB_API_KEY=your-tmdb-api-key-here

# ─── Бэкап БД (автоматически раз в 2 недели, см. backend/services/backup.py) ───
# OAuth-токен Яндекс Диска
YANDEX_API_KEY=your-yandex-oauth-token-here
# Dropbox: refresh-токен + app key/secret приложения
# (https://www.dropbox.com/developers/apps). Access-токен перед каждой выгрузкой
# запрашивается заново через refresh — хранить его НЕ нужно.
DROPBOX_REFRESH_TOKEN=your-dropbox-refresh-token-here
DROPBOX_APP_KEY=your-dropbox-app-key-here
DROPBOX_APP_SECRET=your-dropbox-app-secret-here


# ─── WordPress (контентный сайт с новостями, порт 8080) ───
# Своя база MariaDB (значения по умолчанию подходят для локального запуска,
# в production поменяйте)
WORDPRESS_DB_USER=wp_user
WORDPRESS_DB_PASSWORD=wp_password
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_ROOT_PASSWORD=wp_root_password
